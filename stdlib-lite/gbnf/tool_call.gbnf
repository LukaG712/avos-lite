root   ::= "{" ws "\"tool\":" ws string "," ws "\"args\":" ws object ws "}"
object ::= "{" ws (string ":" ws value ("," ws string ":" ws value)*)? ws "}"
value  ::= string | number | "true" | "false" | "null"
string ::= "\"" ([^"\\] | "\\" .)* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws     ::= [ \t\n\r]*
